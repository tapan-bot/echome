# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API. The first two are public by design and are the only
# Supabase values a browser is allowed to see.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses Row Level Security, so it must never be imported from a
# client component. lib/supabase/admin.ts is the single place that reads it and
# it carries a server-only guard.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional. Conversation model: claude-opus-5 (default), claude-sonnet-5 or claude-haiku-4-5.
ECHOME_CHAT_MODEL=

# --- Session encryption -----------------------------------------------------
# 32 random bytes, base64. This wraps every per-session data key. Losing it means
# every open conversation becomes permanently unreadable — which is the intended
# failure mode, but back it up in a password manager anyway.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_MASTER_KEY=

# --- App --------------------------------------------------------------------
# Used to build the email confirmation and password reset redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (Phase 3) -------------------------------------------------------
# Price ids from the Stripe dashboard. The amounts shown in the app come from
# lib/config/pricing.ts, but Stripe charges whatever these price objects say.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ACCESS=
STRIPE_PRICE_FOUNDERS=

# --- Resend (Phase 3) -------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="EchoMe <hello@echomechat.ai>"
ECHO_CIRCLE_URL=

# --- xTiles (Phase 2) -------------------------------------------------------
# xTiles connects over MCP with OAuth, and EchoMe registers itself with xTiles, so no
# client id or secret is needed here. Optional:
#   XTILES_TEMPLATE_URL  the link where members add the EchoMe template (EchoHub) to their xTiles
#   XTILES_MCP_URL       override the MCP server (defaults to https://mcp.xtiles.app/mcp)
#   XTILES_DIAGNOSE=1    TEMPORARY: lets a signed-in tester see how their own workspace answers
XTILES_TEMPLATE_URL=

# --- Cron (Phase 2) ---------------------------------------------------------
# Vercel Cron sends this as a bearer token. Without it, anyone who finds the
# URL can trigger a mailout.
CRON_SECRET=
# The inactivity window, in hours. The brief asks for 48-72 and configurable.
NUDGE_IDLE_HOURS=48
NUDGE_IDLE_UNTIL_HOURS=72

# --- Local development ------------------------------------------------------
# Replaces auth with a cookie and the database with a JSON file. Refuses to run
# in production. Never set this anywhere real.
# ECHOME_LOCAL_MODE=1
# With local mode on: skip the login screen and sign in as preview@example.com.
# Ignored unless ECHOME_LOCAL_MODE=1.
# ECHOME_LOCAL_AUTOLOGIN=1
